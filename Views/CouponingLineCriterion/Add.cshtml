@model CouponLineCriteriaAddViewModel
@using Nwazet.Commerce.Models;
@using Nwazet.Commerce.ViewModels.Couponing;

@{
    Layout.Title = T("Add a Criterion");
}

@if (!Model.Criteria.Any()) {
    <h3>@T("There are no currently available criteria")</h3>
}

@foreach (var criterion in Model.Criteria.OrderBy(x => x.Name.Text)) {
    <h2>@criterion.Name</h2>

    <table class="items">
        <thead>
            <tr>
                <th scope="col" style="width:300px">@T("Name")</th>
                <th scope="col">@T("Description")</th>
            </tr>
        </thead>
        @foreach (var descriptor in criterion.Descriptors) {
            var displayText = descriptor.Name.Text;
            if (!descriptor.IsAvailableForProcessing) {
                displayText += T(" (this provider is disabled for processing. It will be ignored when using the coupon.)");
            }
            <tr>
                <td>
                    @Html.ActionLink(displayText,
                        "Edit",
                        new {
                            id = Model.Id,
                            category = descriptor.Category,
                            type = descriptor.Type })
                </td>
                <td>@descriptor.Description</td>
            </tr>
        }
    </table>
}
