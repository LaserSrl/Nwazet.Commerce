@using Nwazet.Commerce.Models;

@model Nwazet.Commerce.ViewModels.ProductAttributePartEditViewModel
@{
    Style.Require("Nwazet.Attribute-Admin").AtHead();

    Script.Require("jQueryUI_Sortable").AtFoot();
    Script.Require("Mustache").AtFoot();

    var idAttribute = Html.IdFor(m => m.AttributeValueRecords);
    var nameAttribute = Html.FieldNameFor(m => m.AttributeValueRecords);
    var nameDeletedAttribute = Html.FieldNameFor(m => m.AttributeValueRecords);
}
<fieldset>
    <label class="sub" for="@Html.IdFor(m => m.DisplayName)">@T("Display Name")</label><br />
    @Html.TextBoxFor(m => m.DisplayName, new { @class = "text medium" })
    @if (!string.IsNullOrEmpty(Model.TechnicalName)) {
        <span class="hint">@T("Technical Name: {0}", Model.TechnicalName)</span>
        @Html.HiddenFor(m => m.TechnicalName)
    }
    <span class="hint">@T("Label for attribute drop-down list. Leave empty to hide label.")</span><br />

    @if (string.IsNullOrEmpty(Model.TechnicalName)) {
        <label for="TechnicalName" class="required">@T("Technical Name")</label>
        @Html.TextBoxFor(m => m.TechnicalName, new { @class = "text" })
        <span class="hint">@T("Technical name of the attribute.")</span><br />
    }

    <label class="sub" for="@Html.IdFor(m => m.CssName)">@T("Css Name")</label><br />
    @Html.TextBoxFor(m => m.CssName, new { @class = "text large" })<br />
    <span class="hint">@T("The value allows you to add styling to the html of the attribute.")</span><br />

    <label class="sub" for="@Html.IdFor(m => m.Meaning)">@T("Meaning")</label><br />
    @Html.TextBoxFor(m => m.Meaning, new { @class = "text large" })<br />
    <span class="hint">@T("Allows discrimination between attributes. It is placed in the html of the attribute either among the css classes  (meaning-{valore})  or as a data attribute.")</span><br />

    <label class="sub" for="@Html.IdFor(m => m.SortOrder)">@T("Sort Order")</label><br />
    @Html.TextBoxFor(m => m.SortOrder, new { @class = "text small" })<br />
    <span class="hint">@T("Order in which attributes are displayed.")</span><br />
</fieldset>
<fieldset>
    <legend>@T("Attribute Value Options")</legend>
    <div class="hint">@T("Name is the option text displayed for the user to select.")</div>
    <div class="hint">@T("Sort Order determines the order in which options are displayed relative to each other.")</div>
    <div class="hint">@T(@"Price Adjustment is the amount the price will be adjusted for each item that has the attribute selected. Use negative adjustments to reduce the price.")</div>
    <div class="hint">@T(@"When checked, Apply To Line causes the price adjustment to be applied to the line total. By default, the adjustment is applied to the unit price.")</div>
    <ul id="@idAttribute">
        <li class="header">
            <div class="option-name">@T("Name")</div>
            <div class="price-adj">@T("Price Adjustment")</div>
            <div class="apply-line">@T("Apply To Line")</div>
            @if (Model.AttributeExtensionProviders != null) {
                <div class="extension">@T("Extension")</div>
            }
        </li>

        @{int i = 0;}
        @foreach (var value in Model.AttributeValueRecords) {
            <li class="option">
                <div class="option-name">
                    <input type="hidden" name="@(nameAttribute + ".Index")" value="@i" />
                    <input type="hidden" name="@Html.FieldNameFor(m => m.AttributeValueRecords[i].AttributeValueRecord.SortOrder)" value="@value.AttributeValueRecord.SortOrder" />
                    <input type="hidden" name="@Html.FieldNameFor(m => m.AttributeValueRecords[i].AttributeValueRecord.Id)" value="@value.AttributeValueRecord.Id" />
                    <input type="hidden" name="@Html.FieldNameFor(m => m.AttributeValueRecords[i].AttributeValueRecord.GUIdentifier)" value="@value.AttributeValueRecord.GUIdentifier" />
                    <input type="hidden" class="attribute-record-deleted" name="@Html.FieldNameFor(m => m.AttributeValueRecords[i].Deleted)" value="@value.Deleted.ToString()" />
                    <input type="text" class="text" name="@Html.FieldNameFor(m => m.AttributeValueRecords[i].AttributeValueRecord.Text)" value="@value.AttributeValueRecord.Text" />
                </div>
                <div class="price-adj">
                    <input type="text" class="text small" name="@Html.FieldNameFor(m => m.AttributeValueRecords[i].AttributeValueRecord.PriceAdjustment)" value="@value.AttributeValueRecord.PriceAdjustment" />
                </div>
                <div class="apply-line">
                    <input type="checkbox" name="@Html.FieldNameFor(m => m.AttributeValueRecords[i].AttributeValueRecord.IsLineAdjustment)" @(value.AttributeValueRecord.IsLineAdjustment ? "checked='checked'" : "") value="True" />
                </div>
                @if (Model.AttributeExtensionProviders.Count() > 0) {
                    <div class="extension">
                        <select name="@Html.FieldNameFor(m => m.AttributeValueRecords[i].AttributeValueRecord.ExtensionProvider)">
                            <option value="">None</option>
                            @foreach (var provider in Model.AttributeExtensionProviders) {
                                <option value="@provider.Name" @(value.AttributeValueRecord.ExtensionProvider == provider.Name ? "selected" : "")>@provider.DisplayName</option>
                            }
                        </select>
                    </div>
                }
                <div><a href="#" class="nwazet-remove-attribute-value">@T("Delete")</a></div>
            </li>
            i++;
        }
    </ul>
    <button id="@(idAttribute+"_AddAttributeValue")">@T("Add Attribute Value")</button>
</fieldset>

<script type="x-tmpl-mustache" id="valueTemplate">
    <li class="option">
        <div class="option-name">
            <input type="hidden" name="NwazetCommerceAttribute.AttributeValueRecords.Index" value="{{ index }}" />
            <input type="hidden" name="NwazetCommerceAttribute.AttributeValueRecords[{{ index }}].AttributeValueRecord.SortOrder" value="{{ sort }}" />
            <input type="hidden" name="NwazetCommerceAttribute.AttributeValueRecords[{{ index }}].AttributeValueRecord.Id" value="-1" />
            <input type="hidden" name="NwazetCommerceAttribute.AttributeValueRecords[{{ index }}].AttributeValueRecord.GUIdentifier" value="@Guid.NewGuid().ToString()" />
            <input type="hidden" class="attribute-record-deleted" name="NwazetCommerceAttribute.AttributeValueRecords[{{ index }}].AttributeValueRecord.Deleted" value="false" />
            <input type="text" class="text" name="NwazetCommerceAttribute.AttributeValueRecords[{{ index }}].AttributeValueRecord.Text" />
        </div>
        <div class="price-adj">
            <input type="text" class="text small" name="NwazetCommerceAttribute.AttributeValueRecords[{{ index }}].AttributeValueRecord.PriceAdjustment" value="0" />
        </div>
        <div class="apply-line">
            <input type="checkbox" name="NwazetCommerceAttribute.AttributeValueRecords[{{ index }}].AttributeValueRecord.IsLineAdjustment" value="True" />
        </div>
        @if (Model.AttributeExtensionProviders.Count() > 0) {
            <div class="extension">
                <select name="NwazetCommerceAttribute.AttributeValueRecords[{{ index }}].AttributeValueRecord.ExtensionProvider">
                    <option value="">None</option>
                    @foreach (var provider in Model.AttributeExtensionProviders) {
                        <option value="@provider.Name">@provider.DisplayName</option>
                    }
                </select>
            </div>
        }
        <div><a href="#" class="nwazet-remove-attribute-value">@T("Delete")</a></div>
    </li>
</script>

@using (Script.Foot()) {
    <script type="text/javascript">
        @if (string.IsNullOrEmpty(Model.TechnicalName)) {
            <text>
            $(function () {
                var $technicalName = $("#@Html.FieldIdFor(m=>m.TechnicalName)");
                var $displayName = $("#@Html.FieldIdFor(m=>m.DisplayName)");

                var jsonUrl = "@Url.Action("AttributeName", "AttributesAdmin", new RouteValueDictionary { {"Area","Nwazet.Commerce"} } )";
                var version = 0;

                var nameAltered;
                $technicalName.keypress(function () {
                    nameAltered = true;
                });

                var compute = function () {
                    // stop processing automatically if altered by the user
                    if (nameAltered) {
                        return true;
                    }

                    $.post(jsonUrl, {
                    displayName: $displayName.val(),
                        version: ++version, //this is used to handle multiple "almost-concurrent" calls
                        __RequestVerificationToken: $("input[name=__RequestVerificationToken]").val()
                    },
                        function (data) {
                        if (version == data.version) {
                                $technicalName.val(data.result);
                        }
                    },
                        "json"
                    );
                };

                //pull technical name input from tab order
                $technicalName.attr("tabindex", -1);

                $displayName.keyup(compute);
                $displayName.blur(compute);
            })
        </text>
        }

        $(function () {

            var i = $("#@idAttribute > li.option").length; // indexer for mvc model binding new tiers

            $("#@(idAttribute + "_AddAttributeValue")").click(function (event) {
                event.preventDefault();
                var valueTemplate = $("#valueTemplate").html();
                $("#@idAttribute")
                    .append(Mustache.render(valueTemplate, { index: i, sort: i + 1 }))
                    .last()
                    .find(".option-name input[type=text]")
                    .focus();
                i++;
            });

            $("#@idAttribute").on("click", ".nwazet-remove-attribute-value", function (event) {
                event.preventDefault();
                $(this).parents("li").hide();
                $(this).parents("li").find("input.attribute-record-deleted").val('True');
            });

            $("#@idAttribute").sortable({
                update: function () {
                    $.each($(this).children("li"), function () {
                        var $row = $(this);
                        $row.find("input[name$=SortOrder]").val($row.index());
                    });
                }
            });
        });
    </script>
}