@using Nwazet.Commerce.ViewModels.Combinations
@using Orchard;
@using Orchard.ContentManagement;
@using Orchard.Core.Contents;
@using Orchard.Utility.Extensions;
@using Orchard.Localization.Models;
@model CombinationContainerPartEditViewModel
@{ 
    var shortGuid = "c" + Guid.NewGuid().ToString().Split(new char[] { '-' })[0];
    var _contentManager = WorkContext.Resolve<IContentManager>();
    var currentUrl = ViewContext.RequestContext.HttpContext.Request.RawUrl;

    var titleParameter = "__COMBINATION__TITLE__";
    var editUrlParameter = "__COMBINATION__EDITURL__";
    var statusParameter = "__COMBINATION__STATUS__";
    var deleteUrlParameter = "__COMBINATION__DELETEURL__";
}
<fieldset class="product-combination-container" id="@shortGuid">
    <legend>
        @T("Manage product combinations")
    </legend>
    <div class="row">
        <div class="col-lg-8">
            @* List of existing combinations *@
            <div class="product-combinations-list box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title">@T("Combinations")</h3>
                </div>
                <div class="box-body table-responsive no-padding">
                    <table id="table-@shortGuid" class="table table-hover">
                        <thead>
                            <tr>
                                <th>@T("Title")</th>
                                <th>@T("Status")</th>
                                <th>@T("Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr id="template-tr-@shortGuid" style="display:none">
                                <td>
                                    <a href="@editUrlParameter">@titleParameter</a>
                                </td>
                                <td>@statusParameter</td>
                                <td><a class="btn btn-danger btn-xs text-white" href="@deleteUrlParameter" itemprop="RemoveUrl UnsafeUrl">@T("Delete")</a></td>
                            </tr>

                            @foreach (var combination in Model.CurrentCombinations) {
                                <tr>
                                    <td>
                                        @if (Authorizer.Authorize(Permissions.EditContent, combination)) {
                                            @Html.ItemEditLinkWithReturnUrl(
                                                //Html.ItemDisplayText((IContent)(combination.ContentItem)).ToHtmlString(), 
                                                Model.CombinationTitles[combination.Id],
                                                (IContent)(combination.ContentItem))
                                        } else {
                                            @Model.CombinationTitles[combination.Id]
                                        }
                                    </td>
                                    <td>
                                        @if (Model.CombinationsIdDuplicated.ContainsKey(combination.Id) &&
                                            Model.CombinationsIdDuplicated[combination.Id]) {
                                            @T("(Combination Duplicated)")
                                        }
                                        @if (combination.ContentItem.As<LocalizationPart>() != null && combination.ContentItem.As<LocalizationPart>().Culture == null) {
                                            @T("(Missing culture)")
                                        }
                                        @if (combination.HasPublished()) {
                                            @T("(Published)")
                                        } else {
                                            @T("(Not Published)")
                                        }
                                        @if (combination.HasDraft()) {
                                            @T("(Draft)")
                                        } else {
                                            @T("(No Draft)")
                                        }
                                    </td>
                                    <td>
                                        @* We prevent publication of combinations from here, because there is no easy
                                            way to properly trigger all required validations. *@
                                        @if (combination.HasPublished()) {
                                            @*if (combination.HasDraft()) {
                                                if (Authorizer.Authorize(Permissions.PublishContent, combination)) {
                                                    @Html.Link(T("Publish Draft").Text, 
                                                        Url.Action("Publish", "Admin", new {area = "Contents", id = combination.ContentItem.Id, returnUrl = currentUrl}),
                                                        new {itemprop = "UnsafeUrl", @class="btn btn-success btn-xs"})
                                                  }
                                            }*@
                                            if (Authorizer.Authorize(Permissions.PublishContent, combination)) {
                                                @Html.Link(T("Unpublish").Text, 
                                                    Url.Action("Unpublish", "Admin", new {area = "Contents", id = combination.ContentItem.Id, returnUrl = currentUrl}),
                                                    new {itemprop = "UnsafeUrl", @class= "btn btn-warning btn-xs text-white" })
                                            }
                                        } else {
                                            @*if (Authorizer.Authorize(Permissions.PublishContent, combination)) {
                                                @Html.Link(T("Publish").Text, 
                                                    Url.Action("Publish", "Admin", new {area = "Contents", id = combination.ContentItem.Id, returnUrl = currentUrl}),
                                                    new {itemprop = "UnsafeUrl", @class="btn btn-success btn-xs"})
                                            }*@
                                        }
                                        @if (Authorizer.Authorize(Permissions.DeleteContent, combination)) {
                                            @Html.Link(T("Delete").Text, 
                                                Url.ItemRemoveUrl(combination.ContentItem, new { returnUrl = currentUrl }), 
                                                new { itemprop = "RemoveUrl UnsafeUrl", @class="btn btn-danger btn-xs text-white" })
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            @* List of attributes *@
            <div class="product-combination-attributes box box-primary">
                <div class="box-header with-border">
                    <h3 class="box-title">@T("Attributes")</h3>
                </div>
                @if (Model.AllAttributeParts.Any()) {
                    @* Nested forms are not allowed, so we use the formaction attribute of the submit button *@
                    <div class="box-body">
                        @foreach(var att in Model.AllAttributeParts) {
                            var attDisplayName = att.DisplayName;
                            if (string.IsNullOrWhiteSpace(attDisplayName)) {
                                attDisplayName = _contentManager.GetItemMetadata(att).DisplayText;
                            }
                            <div class="single-attribute box box-default">
                                @* TODO: make this card collapsible *@
                                <div class="box-header with-border">
                                    <h3 class="box-title">@(attDisplayName)</h3>
                                </div>
                                <div class="box-body">
                                    @foreach(var attVal in att.AttributeValues) {
                                        <div class="form-check attribute-value-checkbox">
                                            @Html.CheckBox("attribute." + att.Id + "." + attVal.Text,
                                                new {
                                                    @id = "attribute_" + att.Id + "_" + attVal.Text,
                                                    @class = "form-check-input",
                                                    data_attribute_Name = attDisplayName,
                                                    data_attribute_id = att.Id,
                                                    data_attribute_value = attVal.Text
                                                })
                                            @Html.Label(attVal.Text,
                                                new {
                                                    @for = "attribute_" + att.Id + "_" + attVal.Text,
                                                    @class = "form-check-label forcheckbox"
                                                })
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="box-footer">
                        <fieldset class="form-group selected-attributes"
                                  id="@(shortGuid+"_selected_attributes_container")">
                            @* We'll add labels for the selected attributes here *@
                        </fieldset>

                        <div id="@(shortGuid + "generate_results")">
                            <span></span>
                        </div>
                        <button type="button" disabled
                                class="btn btn-primary"
                                id="@(shortGuid + "generate_button")">
                            @T("Generate")
                        </button>
                        @Html.Link(T("Create combination").Text,
                                Url.Action("Create", "CombinationConfigurationAdmin", new { area = "Nwazet.Commerce", id = Model.Part.Id, returnUrl = ViewContext.RequestContext.HttpContext.Request.RawUrl }),
                                new { @class = "button primaryAction" })
                    </div>
                } else {
                    <div class="box-body">
                        @T("There are no attributes to create new combinations.")
                    </div>
                }
            </div>
            @* Button that will cause generation of new combinations *@
        </div>
    </div>
</fieldset>

@using(Script.Foot()) {
    <script type="text/javascript">
        $(document).ready(function () {
            // when adding a checkbox, add a corresponding thing to the list that
            // we will send to generate new combinations
            $('.product-combination-attributes .single-attribute .attribute-value-checkbox input.form-check-input').change(function () {
                // the html element that contains the selected attributes
                var attContainer = $('#@(shortGuid+"_selected_attributes_container")');
                // Id and Value of attribute that was "clicked"
                var attId = $(this).data('attribute-id');
                var attVal = $(this).data('attribute-value');
                var attName = $(this).data('attribute-name');
                // check whether the attribute value is already selected
                var already = attContainer.find('.selected-attribute[data-attribute-id=' + attId + '][data-attribute-value=' + attVal + ']');
                if (this.checked) {
                    // add to list of attributes to combine
                    if (already && already.length) {
                        // nothing to do here
                    } else {
                        // add to the list
                        attContainer
                            .append('<span data-attribute-id="'+ attId +'" data-attribute-value="' + attVal + '" class="selected-attribute btn-success btn-xs">' + attName + ': ' + attVal +'</span>');
                    }
                } else {
                    // remove from list of attributes to combine
                    if (already && already.length) {
                        // remove from list
                        already.remove();
                    } else {
                        // nothing to do here
                    }
                }
                // enable/disable button
                var selectedAttributes = attContainer.find('.selected-attribute');
                if (selectedAttributes && selectedAttributes.length) {
                    $('#@(shortGuid + "generate_button")').prop('disabled', false);
                } else {
                    $('#@(shortGuid + "generate_button")').prop('disabled', true);
                }
            })

            $('#@(shortGuid + "generate_button")').click(function () {
                // Preliminary steps
                $('#@(shortGuid + "generate_button")').prop('disabled', true);
                $('#@(shortGuid + "generate_results") span')[0].innerHTML = '';
                $('#@(shortGuid + "generate_results") span').removeClass('error');
                $('#@(shortGuid + "generate_results") span').removeClass('success');
                // TODO: prevent all other interactions with the page

                // Get the selected attribute values
                var attrElements = $('#@(shortGuid+"_selected_attributes_container") .selected-attribute');
                var attributes = [];
                attrElements.each(function (index, element) {
                    attributes.push({
                        AttributeId: $(element).data('attribute-id'),
                        AttributeValue: $(element).data('attribute-value')
                    });
                });

                var url = '@Url.Action("GenerateCombinations",
                    "CombinationsAdmin",
                    new {
                        area = "Nwazet.Commerce",
                        contentId = Model.Part.Id
                    })';
                var formData = {
                    __RequestVerificationToken: '@Html.AntiForgeryTokenValueOrchard()',
                    selectedAttributes: attributes
                };

                $.post(url, formData)
                    .done(function (data, textStatus, jqXHR) {
                        if (data.ko) {
                            $('#@(shortGuid + "generate_results") span')[0].innerHTML = data.message;
                            $('#@(shortGuid + "generate_results") span').addClass('error');
                        } else if (data.ok) {
                            $('#@(shortGuid + "generate_results") span')[0].innerHTML = data.message;
                            $('#@(shortGuid + "generate_results") span').addClass('success');

                            for (let i = 0; i < data.newCombinations.length; i++) {
                                var status = "";
                                if (data.newCombinations[i].HasPublished) {
                                    status += "@T("(Published)")";
                                } else {
                                    status += "@T("(Not Published)")";
                                }
                                status += " ";
                                if (data.newCombinations[i].HasDraft) {
                                    status += "@T("(Draft)")";
                                } else {
                                    status += "@T("(No Draft)")";
                                }

                                // get the row with id
                                var templateRow = $("#template-tr-@shortGuid");
                                // duplicate it, remove id
                                var newRow = templateRow.clone();

                                var stringNewRow = newRow.html();
                                stringNewRow = stringNewRow.replaceAll("@titleParameter", data.newCombinations[i].Title);
                                stringNewRow = stringNewRow.replaceAll("@editUrlParameter", data.newCombinations[i].EditUrl);
                                stringNewRow = stringNewRow.replaceAll("@statusParameter", status);
                                stringNewRow = stringNewRow.replaceAll("@deleteUrlParameter", data.newCombinations[i].DeleteUrl);

                                newRow.html(stringNewRow);
                                newRow.removeAttr('id');

                                $('#table-@shortGuid tbody').append(newRow);
                                newRow.toggle();
                            }
                        }
                    })
                    .fail(function (jqXHR, textStatus, error) {
                        // Error.
                        // Note that the action won't ever return an error status, so being here is something else
                        $('#@(shortGuid + "generate_results") span')[0].innerHTML = '@T("Unknown error while generating combinations.")';
                    })
                    .always(function (dataS, textStatus, dataE) {
                        // clear the selected attributes
                        $('#@(shortGuid+"_selected_attributes_container") .selected-attribute').remove('');
                        $('.product-combination-attributes .single-attribute .attribute-value-checkbox input.form-check-input').prop( "checked", false );
                    });
            });
        });
    </script>
}