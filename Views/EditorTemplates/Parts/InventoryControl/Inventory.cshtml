@using Nwazet.Commerce.Models
@using Nwazet.Commerce.Services
@using Orchard.ContentManagement
@model Nwazet.Commerce.ViewModels.InventoryEditViewModel

<fieldset>
    @Html.HiddenFor(m => m.Inventory, new { @class = "text" })<label class="sub" for="@Html.IdFor(m => m.OutOfStockMessage)">@T("Out of stock message")</label>
    @Html.TextBoxFor(m => m.OutOfStockMessage, new { @class = "text-medium" })<br />
    <span class="hint">@T("This message will be displayed if the inventory is zero or less. Leave blank for the default message to be used.")</span>
    @Html.CheckBoxFor(m => m.AllowBackOrder)
    <label class="sub" for="@Html.IdFor(m => m.AllowBackOrder)">@T("allow back order")</label><br />
    <span class="hint">@T("If unchecked, the add button won't be visible on the product page when the inventory is zero or less.")</span>
    <label class="sub" for="@Html.IdFor(m => m.MinimumOrderQuantity)">@T("Minimum order quantity")</label>
    @Html.TextBoxFor(m => m.MinimumOrderQuantity, new { @class = "text", @type = "number", min = "1" })<br />
    <label class="sub" for="@Html.IdFor(m => m.MaximumOrderQuantity)">@T("Maximum order quantity")</label>
    @Html.TextBoxFor(m => m.MaximumOrderQuantity, new { @class = "text", @type = "number", min = "0" })
    <span class="hint">@T("Insert 0 (zero) to allow any quantity.")</span>
</fieldset>