@using Nwazet.Commerce.Models
@{Script.Require("Nwazet.Inventory").AtHead();}
@if (Model.Inventory != null && !Model.ContentPart.ContentItem.Has(typeof(BundlePart))) {
    <div class="product inventory">
        @T("Inventory:") <span class="value" data-sku-value="@(((dynamic)Model.ContentPart.ContentItem).ProductPart.Sku)">@Model.Inventory</span>
        <a class="remove" href="#"
           data-id="@Model.ContentPart.ContentItem.Id"
           data-url="@Url.Action("RemoveOne", "ProductAdmin", new {area = "Nwazet.Commerce"})">@T("Remove one")</a>
        <a class="remove" href="#"
           data-id="@Model.ContentPart.ContentItem.Id"
           data-url="@Url.Action("AddOne", "ProductAdmin", new {area = "Nwazet.Commerce"})">@T("Add one")</a>
    </div>
}