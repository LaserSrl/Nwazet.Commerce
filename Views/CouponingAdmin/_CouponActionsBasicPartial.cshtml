@using Nwazet.Commerce.ViewModels.Couponing;
@using System.Globalization;
@model Coupon
@{ 
    var currentCulture = CultureInfo.GetCultureInfo(WorkContext.CurrentCulture);
}

<div class="form-group">
    @Html.LabelFor(m => m.CouponType, 
        T("Value type").Text, 
        new { @for = Html.FieldIdFor(m => m.CouponType) })
    @Html.DropDownListFor(m => m.CouponType, 
        new SelectList(Enum.GetValues(typeof(Nwazet.Commerce.Models.Couponing.CouponType))), 
        T("Select a type").Text, 
        new { @class = "form-control text medium", id = Html.FieldIdFor(m => m.CouponType), aria_describedby = "couponTypeHelp" })
    <small id="couponTypeHelp" class="form-text text-muted hint">@T("The coupon's value type.")</small>
    <small class="form-text text-muted hint">
        @T("The value type affects the meaning given to the value (i.e. how it's used in processing), as well as the order of application for coupons with the same Priority. The possible value types are described in order of priority:")
    </small>
    <small class="form-text text-muted hint">
        @T("CartAmount: fixed amount off the total (after VAT) for the cart.")
    </small>
    <small class="form-text text-muted hint">
        @T("Amount: fixed amount off the price of each single item it applies to. If the amount is 1$, and a cartline the coupon applies to has quantity = 3, the coupon will take 3$ off the final (after VAT) price for that line.")
    </small>
    <small class="form-text text-muted hint">
        @T("Percent: percent of the price of each single item it applies to.")
    </small>
</div>
<div class="form-group">
    @Html.LabelFor(m => m.Value, T("Value/Amount").Text, new { @for = Html.FieldIdFor(m => m.Value) })
    @Html.TextBoxFor(m => m.Value, new {
        @class = "form-control text small",
        step= "0.01", min ="0",
        aria_describedby="couponValueHelp",
        placeholder = T("Coupon's value") })
    @Html.ValidationMessageFor(m => m.Value)
    <small id="couponValueHelp" class="form-text text-muted hint">
        @T("The coupon's value/amount. The decimal separator is '{0}'", currentCulture.NumberFormat.NumberDecimalSeparator)
    </small>
</div>