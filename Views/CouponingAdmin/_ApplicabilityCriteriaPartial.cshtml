
@model Nwazet.Commerce.ViewModels.Couponing.Coupon

<fieldset>
    <legend>@T("Applicability criteria")</legend>
    <span class="hint">
        @T("All configured criteria must be verified for this coupon to be considered valid. Make sure to save your changes to the rest of the coupon before editing the criteria.")
    </span>
    <table class="items">
        <thead>
            <tr>
                <th scope="col">@T("Description")</th>
                <th scope="col" class="actions">
                    @Html.ActionLink(T("+ Add a new Criterion").Text,
                        "Add",
                        new {
                            controller = "CouponingCriterion",
                            area = "Nwazet.Commerce",
                            id = Model.Id })
                </th>
            </tr>
        </thead>
