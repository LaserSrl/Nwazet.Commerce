@using Nwazet.Commerce.ViewModels.Couponing;
@model Coupon

<fieldset>
    <legend>@T("Conditions")</legend>
    <fieldset>
        <legend>@T("The coupon will be allowed only if the following conditions are met (leave blank to always allow the coupon).")</legend>
        <span class="hint">
            @T("All configured criteria must be verified for this coupon to be considered valid. Make sure to save your changes to the rest of the coupon before editing the criteria.")
        </span>
        <table class="items">
            <thead>
                <tr>
                    <th scope="col">@T("Description")</th>
                    <th scope="col" class="actions">
                        @Html.ActionLink(T("+ Add a new Criterion").Text,
                            "Add",
                            new {
                                controller = "CouponingCriterion",
                                area = "Nwazet.Commerce",
                                id = Model.Id })
                    </th>
                </tr>
            </thead>
            @foreach (var criterion in Model.ApplicabilityCriteria) {
                <tr>
                    <td>@criterion.DisplayText</td>
                    <td>
                        @Html.ActionLink(T("Edit").Text,
                            "Edit",
                            new {
                                controller = "CouponingCriterion",
                                area = "Nwazet.Commerce",
                                id = Model.Id,
                                category = criterion.Category,
                                type = criterion.Type,
                                criterionId = criterion.CriterionRecordId }) |
                        @Html.ActionLink(T("Delete").Text,
                            "Delete",
                            new { controller = "CouponingCriterion",
                                area = "Nwazet.Commerce",
                                id = Model.Id,
                                criterionId = criterion.CriterionRecordId },
                            new { itemprop = "RemoveUrl UnsafeUrl" })
                    </td>
                </tr>
            }
        </table>
    </fieldset>
</fieldset>