@using Orchard.ContentManagement
@using Orchard.Utility.Extensions

@{
    Layout.Title = T("New Coupon").Text;
}

@model Nwazet.Commerce.ViewModels.Couponing.Coupon
@using (Html.BeginFormAntiForgeryPost(Url.Action("Create"),
                                        FormMethod.Post, new {
                                            @class = "no-multisubmit"
                                        })) {
    @Html.Partial("_CouponPartial", Model)
    @Html.Partial("_ApplicabilityCriteriaNewCouponPartial", Model)

    <button type="submit" name="submit.Save" class="primaryAction" value="submit.Save">@T("Save")</button>
}